{
  "name": "sahibinden-car-mcp",
  "version": "0.2.1",
  "description": "Local MCP server that lets Claude search, inspect and compare sahibinden.com car listings from pages you saved yourself (no scraping and no network requests by default; optional opt-in browser mode).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "sahibinden",
    "cars",
    "listings",
    "turkey",
    "local-first"
  ],
  "author": "Bilal Gökdağ",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "sahibinden-car-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "chrome": "node scripts/chrome.mjs",
    "demo": "node scripts/render-demo.mjs",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=bundle/server.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --legal-comments=none"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkdgbilal/sahibinden-car-mcp.git"
  },
  "homepage": "https://github.com/gkdgbilal/sahibinden-car-mcp#readme",
  "bugs": {
    "url": "https://github.com/gkdgbilal/sahibinden-car-mcp/issues"
  }
}
